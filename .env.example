# Data Source APIs
GUS_API_KEY=your_gus_key_here
FRED_API_KEY=your_fred_key_here

# Persistence
DYNAMODB_TABLE_NAME=govdata-sessions

# LLM Configuration
# Supported providers: bedrock, openai, openrouter, gemini
# (For Ollama or LM Studio, use provider 'openai' and set OPENAI_API_BASE)
LLM_PROVIDER=bedrock
LLM_MODEL=anthropic.claude-3-haiku-20240307-v1:0

# AWS / Bedrock Settings
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# OpenAI / OpenRouter / Local (Ollama/LM Studio via OpenAI compat API) Settings
OPENAI_API_KEY=your_openai_or_openrouter_key_here
# OPENAI_API_BASE=https://openrouter.ai/api/v1
# OPENAI_API_BASE=http://host.docker.internal:11434/v1 # For Ollama
# OPENAI_API_BASE=http://host.docker.internal:1234/v1  # For LM Studio

# Google Gemini Settings
GOOGLE_API_KEY=your_gemini_key_here